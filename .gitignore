# Unity 6 generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset meta data (only ignore meta for ignored files — keep meta for tracked assets)
# (do NOT ignore *.meta broadly; Unity needs them versioned)

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports & build artifacts
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# OS generated
.DS_Store
Thumbs.db

# Claude local settings (개인 환경별 설정)
.claude/settings.local.json

# ULoop 로컬 산출물 (테스트 결과 XML·스크린샷 등)
.uloop/
# 단 권한 설정은 공유한다 — dynamicCodeSecurityLevel이 dynamic-code 동작을 좌우한다
!.uloop/settings.permissions.json

# External tools (재현은 tools/setup-sprite-gen.ps1)
tools/sprite-gen/

# PixelLab Forge MCP 생성물 (실기 반입 전 임시 산출물)
pixellab-forge-output/
